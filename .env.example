# данные для http подключеня к client gateway
PORT=4030
BASE_URL="http://localhost:4030"
ORIGINS="http://localhost:3100"

# UUID магазина, предложения которого доступны на этой витрине
STOREFRONT_SHOP_UUID=

# данные подключения к rabbitmq
AMQP_PORT=5672
AMQP_HOSTNAME="localhost"
AMQP_USERNAME="admin"
AMQP_PASSWORD="admin"

# queue/exchange для событий client gateway
AMQP_CLIENT_GATEWAY_EVENT_QUEUE="client_gateway_event_queue"
AMQP_CLIENT_GATEWAY_EXCHANGE="client_gateway_exchange"

# command queues инфраструктурных сервисов
AMQP_STORE_SRV_COMMAND_QUEUE="store_srv.command.queue"
AMQP_PRODUCT_SRV_COMMAND_QUEUE=product.v2.commands

# внутренний HTTP endpoint media service
API_MEDIA_SRV="http://localhost:5050"

# Cart, Identity и приватный realtime
AMQP_CART_SRV_COMMAND_QUEUE="cart_srv.command.queue"
AMQP_IDENTITY_SRV_COMMAND_QUEUE="identity_srv_command_queue"
AMQP_CLIENT_GATEWAY_CART_EVENT_QUEUE="client_gateway.cart.event.queue"
AMQP_EVENTS_EXCHANGE="event.exchange"
AUTH_COOKIE="client.sid"
AUTH_COOKIE_SECURE=false
SOCKET_TICKET_SECRET="replace-with-the-same-long-secret-as-socket-gateway"
SOCKET_TICKET_AUDIENCE="realtime"
