# данные для http подключеня к client gateway
PORT=4030
BASE_URL="http://localhost:4030"
ORIGINS="http://localhost:3010"

# данные подключения к rabbitmq
AMQP_PORT=5672
AMQP_HOSTNAME="localhost"
AMQP_USERNAME="admin"
AMQP_PASSWORD="admin"

# queue/exchange для событий client gateway
AMQP_CLIENT_GATEWAY_EVENT_QUEUE="client_gateway_event_queue"
AMQP_CLIENT_GATEWAY_EXCHANGE="client_gateway_exchange"

# command queues инфраструктурных сервисов
AMQP_STORE_SRV_COMMAND_QUEUE="store_srv.command.queue"
AMQP_PRODUCT_SRV_COMMAND_QUEUE="product_srv.command.queue"

# внутренний HTTP endpoint media service
API_MEDIA_SRV="http://localhost:5050"
